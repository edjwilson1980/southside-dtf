# No server secrets required for local shop use without Drive.
# Confirm & Build downloads a CMYK PNG to this computer.

# --- Customer pre-cut → Google Drive (optional) ---
# Share a Drive folder with the service account as Editor, then set:
# GOOGLE_DRIVE_CLIENT_EMAIL=...@....iam.gserviceaccount.com
# GOOGLE_DRIVE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# GOOGLE_DRIVE_PARENT_FOLDER_ID=the_folder_id_from_the_Drive_URL
