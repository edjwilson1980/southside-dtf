# No server secrets required for local shop use without Drive.
# Confirm & Build downloads a CMYK PNG to this computer.

# --- Customer pre-cut → Google Drive ---
# Personal Gmail cannot use Shared drives. Use OAuth as the shop Google account:
#
# 1) Google Cloud Console → APIs & Services → Credentials → Create OAuth client (Web)
# 2) Redirect URI: https://YOUR_DOMAIN/api/drive/oauth/callback
#    (local: http://localhost:3000/api/drive/oauth/callback)
# 3) Visit /shop/connect-drive, sign in, copy the refresh token
#
GOOGLE_DRIVE_OAUTH_CLIENT_ID=
GOOGLE_DRIVE_OAUTH_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_PARENT_FOLDER_ID=1knne_BemsOzP77RToOkLsaXk_qpuu_kl

# Optional Workspace Shared Drive path (service account) — not for personal Gmail:
# GOOGLE_DRIVE_CLIENT_EMAIL=...@....iam.gserviceaccount.com
# GOOGLE_DRIVE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
